<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SplitBillApp.Views.SplashPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2AA06C" Offset="0.0" />
            <GradientStop Color="#1F8A5B" Offset="0.55" />
            <GradientStop Color="#16714A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- Everything fades/slides in from code-behind -->
        <VerticalStackLayout x:Name="Root" Spacing="0" Opacity="0" TranslationY="24"
                             HorizontalOptions="Center" VerticalOptions="Center">

            <!-- Logo: tally marks on a white rounded tile -->
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 34"
                    WidthRequest="140" HeightRequest="140" HorizontalOptions="Center">
                <Image Source="tallymark.svg" WidthRequest="92" HeightRequest="92"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Accent}" />
                    </Image.Behaviors>
                </Image>
            </Border>

            <!-- Wordmark -->
            <Label Text="TallyMore" TextColor="White" FontFamily="PJSansExtra" FontSize="40"
                   HorizontalOptions="Center" Margin="0,26,0,0" />
            <Label Text="Track, split &amp; share." TextColor="White" Opacity="0.85"
                   FontFamily="PJSansSemibold" FontSize="15" HorizontalOptions="Center"
                   Margin="0,6,0,0" />

        </VerticalStackLayout>

        <!-- Footer -->
        <Label Text="by Magsenium" TextColor="White" Opacity="0.55"
               FontFamily="PJSansMedium" FontSize="12" HorizontalOptions="Center"
               VerticalOptions="End" Margin="0,0,0,36" />
    </Grid>
</ContentPage>
