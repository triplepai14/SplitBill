<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SplitBillApp.ViewModels"
             x:Class="SplitBillApp.Views.AddExpensePage"
             x:DataType="vm:AddExpenseViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Description" FontAttributes="Bold" />
            <Entry Placeholder="e.g. Dinner at Som Tam" Text="{Binding Description}" />

            <Label Text="Amount" FontAttributes="Bold" />
            <Entry Placeholder="0.00" Keyboard="Numeric" Text="{Binding AmountText}" />

            <Label Text="Paid by" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding People}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding PaidBy}" />

            <Label Text="Split between" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Participants}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:Participant">
                        <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="10">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                            <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Cancel" BackgroundColor="#9E9E9E"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Save Expense"
                        Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
