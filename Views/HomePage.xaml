<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SplitBillApp.ViewModels"
             x:Class="SplitBillApp.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header + tabs -->
        <VerticalStackLayout Grid.Row="0" Padding="24,20,24,10" Spacing="2">
            <Label Text="Your bills" Style="{StaticResource H1}" />
            <Label Text="Keep everyone square." Style="{StaticResource Muted}" />

            <Border Margin="0,16,0,0" Padding="5" BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource LineColor}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                    <Button Grid.Column="0" Text="Bills"
                            Command="{Binding ShowBillsCommand}"
                            BackgroundColor="{Binding BillsTabBg}"
                            TextColor="{Binding BillsTabText}"
                            FontFamily="PJSansBold" FontSize="14"
                            CornerRadius="10" Padding="9" HeightRequest="38" BorderWidth="0" />
                    <Button Grid.Column="1" Text="Categories"
                            Command="{Binding ShowCategoriesCommand}"
                            BackgroundColor="{Binding CatsTabBg}"
                            TextColor="{Binding CatsTabText}"
                            FontFamily="PJSansBold" FontSize="14"
                            CornerRadius="10" Padding="9" HeightRequest="38" BorderWidth="0" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Lists + FAB -->
        <Grid Grid.Row="1">

            <!-- Bills -->
            <CollectionView ItemsSource="{Binding BillCards}"
                            IsVisible="{Binding IsBillsTab}"
                            Margin="20,4,20,0">
                <CollectionView.Footer><BoxView HeightRequest="120" Color="Transparent" /></CollectionView.Footer>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BillCardVM">
                        <Border Style="{StaticResource CardHover}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="13">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Name}" FontFamily="PJSansBold" FontSize="17" />
                                        <Label Text="{Binding PaidByLabel}" Style="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="3">
                                        <Label Text="{Binding TotalLabel}" FontFamily="PJSansExtra"
                                               FontSize="19" HorizontalOptions="End" />
                                        <Label Text="{Binding CategoryName}" IsVisible="{Binding HasCategory}"
                                               TextColor="{StaticResource Accent}" FontFamily="PJSansBold"
                                               FontSize="11" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,0,0,0">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="0"
                                                           BindableLayout.ItemsSource="{Binding Avatars}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AvatarVM">
                                                <Border WidthRequest="{Binding Size}" HeightRequest="{Binding Size}"
                                                        Margin="{Binding Margin}"
                                                        BackgroundColor="{Binding Background}"
                                                        Stroke="{Binding BorderColor}"
                                                        StrokeThickness="{Binding BorderWidth}"
                                                        StrokeShape="RoundRectangle 40">
                                                    <Label Text="{Binding Initial}" TextColor="White"
                                                           FontFamily="PJSansBold" FontSize="{Binding FontSize}"
                                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding CountLabel}" Style="{StaticResource Muted}"
                                           Margin="12,0,0,0" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="🗑" Command="{Binding DeleteCommand}"
                                            BackgroundColor="{StaticResource Surface2}" TextColor="#C63A3A"
                                            FontSize="14" WidthRequest="34" HeightRequest="34"
                                            CornerRadius="10" Padding="0" BorderWidth="0"
                                            VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Categories -->
            <CollectionView ItemsSource="{Binding CategoryCards}"
                            IsVisible="{Binding IsCatsTab}"
                            Margin="20,4,20,0">
                <CollectionView.Footer><BoxView HeightRequest="120" Color="Transparent" /></CollectionView.Footer>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryCardVM">
                        <Border Style="{StaticResource CardHover}" Padding="16,18">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontFamily="PJSansBold" FontSize="17" />
                                    <Label Text="{Binding CountLabel}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                    <Label Text="{Binding TotalLabel}" FontFamily="PJSansExtra"
                                           FontSize="19" HorizontalOptions="End" />
                                    <Label Text="View ›" TextColor="{StaticResource Accent}"
                                           FontFamily="PJSansBold" FontSize="12" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- FAB -->
            <Button Text="+  New bill" Command="{Binding NewBillCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,22,30" HeightRequest="56" Padding="24,0"
                    CornerRadius="18" />
        </Grid>
    </Grid>
</ContentPage>
