<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SplitBillApp.ViewModels"
             x:Class="SplitBillApp.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- A draggable bill row -->
        <DataTemplate x:Key="BillRowTemplate" x:DataType="vm:BillRowVM">
            <Border BackgroundColor="{Binding CardBg}" Stroke="{StaticResource LineColor}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,12" Margin="0,0,0,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                    <DragGestureRecognizer CanDrag="True" DragStarting="OnBillDragStarting"
                                           DropCompleted="OnBillDropCompleted" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="11">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Name}" FontFamily="PJSansBold" FontSize="16" />
                            <Label Text="{Binding PaidByLabel}" TextColor="{Binding CardSub}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding TotalLabel}" FontFamily="PJSansExtra"
                               FontSize="18" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Padding="6,0,0,0">
                        <HorizontalStackLayout Grid.Column="0" Spacing="0"
                                               BindableLayout.ItemsSource="{Binding Avatars}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AvatarVM">
                                    <Border WidthRequest="{Binding Size}" HeightRequest="{Binding Size}"
                                            Margin="{Binding Margin}" BackgroundColor="{Binding Background}"
                                            Stroke="{Binding BorderColor}" StrokeThickness="{Binding BorderWidth}"
                                            StrokeShape="RoundRectangle 40">
                                        <Label Text="{Binding Initial}" TextColor="White" FontFamily="PJSansBold"
                                               FontSize="{Binding FontSize}" HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding CountLabel}" TextColor="{Binding CardSub}"
                               FontSize="13" Margin="10,0,0,0" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="{Binding DoneLabel}" Command="{Binding DoneCommand}"
                                IsVisible="{Binding CanToggleDone}"
                                BackgroundColor="{StaticResource Surface2}" TextColor="{StaticResource Accent}"
                                FontSize="13" WidthRequest="34" HeightRequest="34" CornerRadius="10"
                                Padding="0" BorderWidth="0" Margin="0,0,6,0" VerticalOptions="Center" />
                        <Button Grid.Column="3" Text="📁" Command="{Binding MoveCommand}"
                                BackgroundColor="{StaticResource Surface2}" FontSize="13"
                                WidthRequest="34" HeightRequest="34" CornerRadius="10" Padding="0"
                                BorderWidth="0" Margin="0,0,6,0" VerticalOptions="Center" />
                        <Button Grid.Column="4" Text="📤" Command="{Binding ShareCommand}"
                                BackgroundColor="{StaticResource Surface2}" TextColor="{StaticResource Accent}"
                                FontSize="13" WidthRequest="34" HeightRequest="34" CornerRadius="10"
                                Padding="0" BorderWidth="0" Margin="0,0,6,0" VerticalOptions="Center" />
                        <Button Grid.Column="5" Text="🗑" Command="{Binding DeleteCommand}"
                                BackgroundColor="{StaticResource Surface2}" TextColor="#C63A3A"
                                FontSize="13" WidthRequest="34" HeightRequest="34" CornerRadius="10"
                                Padding="0" BorderWidth="0" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,140" Spacing="0">

                <Label Text="Your bills" Style="{StaticResource H1}" />
                <Label Text="Drag a bill onto a category to file it." Style="{StaticResource Muted}"
                       Margin="0,2,0,16" />

                <!-- Tabs -->
                <Border Padding="5" BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource LineColor}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Margin="0,0,0,18">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                        <Button Grid.Column="0" Text="Pending" Command="{Binding ShowPendingTabCommand}"
                                BackgroundColor="{Binding PendingBg}" TextColor="{Binding PendingText}"
                                FontFamily="PJSansBold" FontSize="14" CornerRadius="10"
                                HeightRequest="38" BorderWidth="0" Padding="9" />
                        <Button Grid.Column="1" Text="Done" Command="{Binding ShowDoneTabCommand}"
                                BackgroundColor="{Binding DoneBg}" TextColor="{Binding DoneText}"
                                FontFamily="PJSansBold" FontSize="14" CornerRadius="10"
                                HeightRequest="38" BorderWidth="0" Padding="9" />
                    </Grid>
                </Border>

                <!-- Category groups (+ Uncategorized), each header is a drop target -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryGroupVM">
                            <VerticalStackLayout Spacing="10">
                                <Border BackgroundColor="{Binding HeaderBg}"
                                        Stroke="{Binding HeaderStroke}" StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 16" Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                        <DropGestureRecognizer AllowDrop="True" Drop="OnCategoryDrop"
                                                               DragOver="OnGroupDragOver"
                                                               DragLeave="OnGroupDragLeave" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Chevron}" FontSize="16"
                                               TextColor="{Binding SubColor}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontFamily="PJSansBold" FontSize="17"
                                                   TextColor="{Binding TitleColor}" />
                                            <Label Text="{Binding CountLabel}" FontSize="12"
                                                   TextColor="{Binding SubColor}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End"
                                                             VerticalOptions="Center" IsVisible="{Binding ShowActions}">
                                            <Label Text="{Binding TotalLabel}" FontFamily="PJSansExtra"
                                                   FontSize="17" HorizontalOptions="End"
                                                   TextColor="{Binding TitleColor}" />
                                            <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                                <Button Text="{Binding DoneLabel}" Command="{Binding DoneCommand}"
                                                        BackgroundColor="{StaticResource Surface}"
                                                        TextColor="{StaticResource Accent}" FontFamily="PJSansBold"
                                                        FontSize="12" CornerRadius="9" HeightRequest="30"
                                                        Padding="10,0" BorderWidth="0" />
                                                <Button Text="View ›" Command="{Binding OpenSummaryCommand}"
                                                        BackgroundColor="Transparent" TextColor="White"
                                                        FontFamily="PJSansBold" FontSize="12" Padding="2,0"
                                                        BorderWidth="0" HeightRequest="30" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="12,0,0,0"
                                                     BindableLayout.ItemsSource="{Binding Bills}"
                                                     BindableLayout.ItemTemplate="{StaticResource BillRowTemplate}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="No bills yet. Tap + to add one." Style="{StaticResource Muted}"
                       IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" Margin="0,60,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Scrim while the speed-dial menu is open -->
        <BoxView Color="#22000000" IsVisible="{Binding IsMenuOpen}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Speed-dial FAB -->
        <VerticalStackLayout HorizontalOptions="End" VerticalOptions="End" Spacing="12"
                             Margin="0,0,22,30">
            <Button Text="New category" Command="{Binding NewCategoryCommand}"
                    IsVisible="{Binding IsMenuOpen}"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource TextColor}"
                    FontFamily="PJSansBold" FontSize="15" CornerRadius="16" HeightRequest="48"
                    Padding="20,0" BorderWidth="0" HorizontalOptions="End" />
            <Button Text="New bill" Command="{Binding NewBillCommand}"
                    IsVisible="{Binding IsMenuOpen}"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource TextColor}"
                    FontFamily="PJSansBold" FontSize="15" CornerRadius="16" HeightRequest="48"
                    Padding="20,0" BorderWidth="0" HorizontalOptions="End" />
            <Button Text="{Binding FabIcon}" Command="{Binding ToggleMenuCommand}"
                    BackgroundColor="{StaticResource Accent}" TextColor="White"
                    FontFamily="PJSans" FontSize="30" CornerRadius="30"
                    WidthRequest="60" HeightRequest="60" Padding="0" BorderWidth="0"
                    HorizontalOptions="End" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
