<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SplitBillApp.ViewModels"
             x:Class="SplitBillApp.Views.CategoryPage"
             x:DataType="vm:CategoryViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
              Padding="16,10,16,12" VerticalOptions="Center">
            <Button Grid.Column="0" Text="‹" Style="{StaticResource IconButton}" Command="{Binding BackCommand}" />
            <Label Grid.Column="1" Text="{Binding CatTitle}" Style="{StaticResource H2}"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Button Grid.Column="2" Text="Rename" Command="{Binding RenameCommand}"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Accent}"
                    FontFamily="PJSansBold" FontSize="14" CornerRadius="12" BorderWidth="0"
                    HeightRequest="40" Padding="14,0" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="20,6,20,28">
            <VerticalStackLayout Spacing="0">

                <!-- Total card -->
                <Border Style="{StaticResource Card}" Padding="22" StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding CatCountLabel, StringFormat='Total across {0}'}"
                               Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        <Label Text="{Binding CatTotalLabel}" FontFamily="PJSansExtra" FontSize="38"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Date + done toggle -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
                    <Border Grid.Column="0" Style="{StaticResource Field}">
                        <DatePicker Date="{Binding CatDate}" Format="ddd d MMM yyyy"
                                    FontFamily="PJSans" TextColor="{StaticResource TextColor}" />
                    </Border>
                    <Button Grid.Column="1" Text="{Binding DoneLabel}" Command="{Binding ToggleDoneCommand}"
                            BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Accent}"
                            FontFamily="PJSansBold" FontSize="13" CornerRadius="14" BorderWidth="1"
                            BorderColor="#BFDECB" HeightRequest="48" Padding="14,0" />
                </Grid>

                <Label Text="BILLS" Style="{StaticResource SectionLabel}" Margin="4,22,4,11" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Bills}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatBillVM">
                            <Border Style="{StaticResource RowHover}" Padding="16,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontFamily="PJSansBold" FontSize="15" />
                                        <Label Text="{Binding PaidByLabel}" Style="{StaticResource Muted}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding TotalLabel}" FontFamily="PJSansExtra"
                                           FontSize="16" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,22,4,11">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleSpentCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="{Binding SpentChevron}" FontSize="13"
                           TextColor="{StaticResource SubText}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="SPENT PER PERSON" Style="{StaticResource SectionLabel}"
                           VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Spacing="9" IsVisible="{Binding ShowSpent}"
                                     BindableLayout.ItemsSource="{Binding People}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatPersonVM">
                            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource LineColor}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,11">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                    <Border Grid.Column="0" WidthRequest="32" HeightRequest="32"
                                            BackgroundColor="{Binding AvatarColor}" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 40" VerticalOptions="Center">
                                        <Label Text="{Binding Initial}" TextColor="White" FontFamily="PJSansBold"
                                               FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Name}" FontFamily="PJSansBold"
                                           FontSize="15" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding AmountLabel}" FontFamily="PJSansExtra"
                                           FontSize="15" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Who pays whom, across every bill in this category -->
                <VerticalStackLayout x:Name="SettleUpSection" IsVisible="{Binding HasSettlements}"
                                     Spacing="0" BackgroundColor="{StaticResource AppBg}" Padding="0,0,0,8">
                    <Label Text="SETTLE UP · WHOLE CATEGORY" Style="{StaticResource SectionLabel}"
                           Margin="4,22,4,11" />
                    <VerticalStackLayout Spacing="9" BindableLayout.ItemsSource="{Binding Settlements}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettlementVM">
                                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource LineColor}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="9">
                                        <Border Grid.Column="0" WidthRequest="28" HeightRequest="28"
                                                BackgroundColor="{Binding FromColor}" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 40" VerticalOptions="Center">
                                            <Label Text="{Binding FromInitial}" TextColor="White"
                                                   FontFamily="PJSansBold" FontSize="12"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding FromName}" FontFamily="PJSansBold"
                                               FontSize="14" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="→" TextColor="{StaticResource SubText}"
                                               FontSize="16" VerticalOptions="Center" />
                                        <Border Grid.Column="3" WidthRequest="28" HeightRequest="28"
                                                BackgroundColor="{Binding ToColor}" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 40" VerticalOptions="Center">
                                            <Label Text="{Binding ToInitial}" TextColor="White"
                                                   FontFamily="PJSansBold" FontSize="12"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="4" Text="{Binding ToName}" FontFamily="PJSansBold"
                                               FontSize="14" VerticalOptions="Center" />
                                        <Label Grid.Column="5" Text="{Binding AmountLabel}"
                                               TextColor="{StaticResource Accent}" FontFamily="PJSansExtra"
                                               FontSize="15" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Share / danger zone -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,26,0,0">
                    <Button Grid.Column="0" Text="📤  Share" Clicked="OnShareClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource Accent}"
                            BorderColor="#BFDECB" BorderWidth="1"
                            FontFamily="PJSansBold" FontSize="14"
                            CornerRadius="14" HeightRequest="46" />
                    <Button Grid.Column="1" Text="🗑  Delete category" Command="{Binding DeleteCommand}"
                            BackgroundColor="Transparent" TextColor="#C63A3A"
                            BorderColor="#EAC7C7" BorderWidth="1"
                            FontFamily="PJSansBold" FontSize="14"
                            CornerRadius="14" HeightRequest="46" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
