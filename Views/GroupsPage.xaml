<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SplitBillApp.ViewModels"
             xmlns:models="clr-namespace:SplitBillApp.Models"
             x:Class="SplitBillApp.Views.GroupsPage"
             x:DataType="vm:GroupsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- New group entry -->
        <Border Grid.Row="0" Stroke="#E0E0E0" StrokeThickness="1"
                StrokeShape="RoundRectangle 12" Padding="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Placeholder="New group name (e.g. Bali Trip)"
                       Text="{Binding NewGroupName}"
                       ReturnCommand="{Binding AddGroupCommand}" />
                <Button Grid.Column="1" Text="Add"
                        Command="{Binding AddGroupCommand}" />
            </Grid>
        </Border>

        <!-- Group list -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Groups}">
                <CollectionView.EmptyView>
                    <Label Text="No groups yet. Create one above to get started."
                           HorizontalOptions="Center" Margin="0,40,0,0"
                           TextColor="#888" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Group">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="#E53935"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=DeleteGroupCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Stroke="#EEE" StrokeShape="RoundRectangle 12"
                                    Padding="14" Margin="0,4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=OpenGroupCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                                        <Label Text="{Binding MemberCount, StringFormat='{0} people'}"
                                               FontSize="13" TextColor="#888" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" VerticalOptions="Center"
                                           Text="{Binding TotalSpent, StringFormat='{0:N2}'}"
                                           FontSize="16" FontAttributes="Bold" TextColor="#2E7D32" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
