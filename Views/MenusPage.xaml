<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SplitBillApp.ViewModels"
             x:Class="SplitBillApp.Views.MenusPage"
             x:DataType="vm:MenusViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,10,20,12"
              ColumnSpacing="10" VerticalOptions="Center">
            <Button Grid.Column="0" Text="‹" Style="{StaticResource IconButton}"
                    Command="{Binding BackCommand}" />
            <Label Grid.Column="1" Text="{Binding MenusTitle}" Style="{StaticResource H2}"
                   VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="0">
                <Label Text="Total" FontFamily="PJSansSemibold" FontSize="11"
                       TextColor="{StaticResource SubText}" HorizontalOptions="End" />
                <Label Text="{Binding RunningLabel}" FontFamily="PJSansExtra" FontSize="16"
                       HorizontalOptions="End" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20,6,20,24">
            <VerticalStackLayout Spacing="16">

                <!-- Mode toggle -->
                <Border Padding="5" BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource LineColor}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                        <Button Grid.Column="0" Text="Split a total" Command="{Binding ModeFlatCommand}"
                                BackgroundColor="{Binding FlatBg}" TextColor="{Binding FlatText}"
                                FontFamily="PJSansBold" FontSize="14" CornerRadius="10"
                                HeightRequest="38" BorderWidth="0" Padding="9" />
                        <Button Grid.Column="1" Text="Itemize" Command="{Binding ModeItemsCommand}"
                                BackgroundColor="{Binding ItemsBg}" TextColor="{Binding ItemsText}"
                                FontFamily="PJSansBold" FontSize="14" CornerRadius="10"
                                HeightRequest="38" BorderWidth="0" Padding="9" />
                    </Grid>
                </Border>

                <!-- Flat total -->
                <Border Style="{StaticResource Card}" Padding="18,24" IsVisible="{Binding IsFlat}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="TOTAL BILL AMOUNT" FontFamily="PJSansBold" FontSize="12"
                               TextColor="{StaticResource SubText}" HorizontalOptions="Center" />
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="฿" FontFamily="PJSansExtra" FontSize="32"
                                   TextColor="{StaticResource SubText}" VerticalOptions="Center" />
                            <Entry Text="{Binding FlatTotal}" Placeholder="0" Keyboard="Numeric"
                                   FontFamily="PJSansExtra" FontSize="44" WidthRequest="190"
                                   HorizontalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding FlatEachLabel}" Style="{StaticResource Muted}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Itemized -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsItems}">
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MenuRowVM">
                                <Border Style="{StaticResource Card}" Padding="16,15">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Name}" FontFamily="PJSansBold" FontSize="16" />
                                                <Label Text="{Binding SplitLabel}" Style="{StaticResource Muted}"
                                                       FontSize="12" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding PriceLabel}"
                                                   FontFamily="PJSansExtra" FontSize="17"
                                                   VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="✕" Command="{Binding RemoveCommand}"
                                                    BackgroundColor="{StaticResource Surface2}"
                                                    TextColor="{StaticResource SubText}" FontSize="13"
                                                    WidthRequest="28" HeightRequest="28" CornerRadius="8"
                                                    Padding="0" BorderWidth="0" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="TAP TO EXCLUDE FROM THIS ITEM" FontFamily="PJSansSemibold"
                                               FontSize="11" TextColor="{StaticResource SubText}"
                                               Margin="0,13,0,8" />
                                        <FlexLayout Wrap="Wrap" Direction="Row"
                                                    BindableLayout.ItemsSource="{Binding ExcludeChips}"
                                                    BindableLayout.ItemTemplate="{StaticResource ChipTemplate}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Add item -->
                    <Border BackgroundColor="{StaticResource Surface2}" Stroke="{StaticResource LineColor}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16,15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Add an item" Style="{StaticResource SectionLabel}" />
                            <Border Style="{StaticResource Field}" StrokeShape="RoundRectangle 12">
                                <Entry Text="{Binding ItemName}" Placeholder="Item name (e.g. Pad Thai)" FontSize="15" />
                            </Border>
                            <Grid ColumnDefinitions="128,*" ColumnSpacing="8">
                                <Border Grid.Column="0" Style="{StaticResource Field}" StrokeShape="RoundRectangle 12">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="฿" FontFamily="PJSansBold" TextColor="{StaticResource SubText}"
                                               VerticalOptions="Center" />
                                        <Entry Text="{Binding ItemPrice}" Placeholder="0" Keyboard="Numeric"
                                               FontSize="15" WidthRequest="80" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Button Grid.Column="1" Text="Add item" Command="{Binding AddItemCommand}"
                                        BackgroundColor="{StaticResource Accent}" TextColor="White"
                                        FontFamily="PJSansBold" FontSize="15" CornerRadius="12"
                                        HeightRequest="46" BorderWidth="0" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="20,14,20,28">
            <Button Text="See who owes what" Command="{Binding FinishCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>
    </Grid>
</ContentPage>
