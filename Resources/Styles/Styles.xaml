<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SplitBillApp.ViewModels"
    xmlns:bx="clr-namespace:SplitBillApp.Behaviors">

    <!-- Reusable selectable pill for people / payer / category / exclusions -->
    <DataTemplate x:Key="ChipTemplate" x:DataType="vm:ToggleChip">
        <Border BackgroundColor="{Binding Background}" Stroke="{Binding StrokeColor}"
                StrokeThickness="1" StrokeShape="RoundRectangle 999"
                Padding="12,7" Margin="0,0,8,8">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                <Border IsVisible="{Binding HasAvatar}" WidthRequest="22" HeightRequest="22"
                        BackgroundColor="{Binding AvatarBackground}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 40">
                    <Label Text="{Binding Initial}" TextColor="White" FontFamily="PJSansBold"
                           FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="👑" IsVisible="{Binding IsPayer}" FontSize="12"
                       VerticalOptions="Center" Margin="0,0,-2,0" />
                <Label Text="{Binding Name}" TextColor="{Binding TextColor}"
                       TextDecorations="{Binding TextDecorations}"
                       FontFamily="PJSansSemibold" FontSize="14" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </DataTemplate>

    <!-- ===================== Global defaults ===================== -->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="PJSans" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="PJSans" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource SubText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===================== Named building blocks ===================== -->

    <!-- Rounded white card -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource LineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Tappable card: soft green tint that FADES in on hover, deepens while
         the tap is held (with a slight shrink), then eases back -->
    <Style x:Key="CardHover" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="bx:InteractiveHighlight.IsEnabled" Value="True" />
    </Style>

    <!-- Tappable list row (smaller radius), same animated treatment -->
    <Style x:Key="RowHover" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource LineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="bx:InteractiveHighlight.IsEnabled" Value="True" />
    </Style>

    <!-- Big page heading, e.g. "Your bills" -->
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="PJSansExtra" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
    </Style>

    <!-- Header title on inner pages -->
    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="PJSansBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
    </Style>

    <!-- Small uppercase / section labels -->
    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="PJSansBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource SubText}" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource SubText}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Primary green pill button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="PJSansBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Neutral input field wrapper -->
    <Style x:Key="Field" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource LineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14,4" />
    </Style>

    <!-- Round icon button used for the back chevron -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontFamily" Value="PJSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

</ResourceDictionary>
